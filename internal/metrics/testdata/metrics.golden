jbod_component_info{component="TEMP A",component_id="3,0",enclosure="1:0:0:0",enclosure_id="ENC1",health="ok",status="OK",type="temperature sensor"} 1
jbod_component_info{component="TEMP B",component_id="3,1",enclosure="1:0:0:0",enclosure_id="ENC1",health="unknown",status="Unsupported",type="temperature sensor"} 1
jbod_component_info{component="VOLT 12V",component_id="4,0",enclosure="1:0:0:0",enclosure_id="ENC1",health="ok",status="OK",type="voltage sensor"} 1
